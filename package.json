{
  "name": "bintv",
  "version": "1.0.0",
  "description": "BinTV - 24/7 channel & live event viewer with dynamic IPTV M3U playlist generation",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:client && npm run build:vendor",
    "build:server": "tsc -p tsconfig.json",
    "build:client": "tsc -p src/client/tsconfig.json",
    "build:vendor": "node scripts/copy-vendor.js",
    "prestart": "npm run build",
    "start": "node dist/server.js",
    "dev": "npm run build && node dist/server.js",
    "test": "npm run build:server && node --test dist/tests/*.test.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "hls.js": "^1.5.20",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.5",
    "typescript": "^5.7.2"
  }
}
