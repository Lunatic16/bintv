# BinTV Environment Configuration

# Host port mapping (maps host 3015 -> container 3010)
PORT=3015

# Default time zone for EPG and viewer display times (IANA format, e.g. America/New_York, UTC, Europe/London)
DEFAULT_TZ=UTC

# BinTV Public API feed URL & poll interval in minutes (default: 5)
EVENT_FEED_URL=https://api.bintv.link/api/public/bintvjson
EVENT_FEED_INTERVAL_MINUTES=5

# Pre-start window (minutes before start time to mark an event as Live)
PRE_START_MINUTES=10

# Post-end grace window (minutes after end time to keep event marked as Live)
POST_END_GRACE_MINUTES=15

# Retention window for ended events before automatic pruning (in hours)
RETENTION_HOURS=24

# Security tokens (optional)
# ADMIN_TOKEN=your-secret-admin-token
# PLAYLIST_TOKEN=your-secret-playlist-token
